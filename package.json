{
  "name": "kalora",
  "version": "1.0.0",
  "private": true,
  "description": "KALORA – Track. Analyse. Erfolg. Ernährungs-, Rezept- und Einkaufsassistent",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "verify-images": "node --env-file-if-exists=.env scripts/verify-images.js",
    "build-images": "node scripts/build-meal-images.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "express": "^4.21.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  }
}